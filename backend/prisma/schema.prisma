generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum AttendanceEventType {
  CLOCK_IN
  CLOCK_OUT
}

enum ClockOutReason {
  BREAK
  END_OF_DAY
}

enum CustomerType {
  WALK_IN
  INSURANCE
  DEALER
  FLEET
  TRADE
  BUSINESS
  SUPPLIER
}

enum LeadSource {
  WALK_IN
  PHONE_CALL
  DEALER_VISIT
  INSURANCE_COMPANY
  REFERRAL
  WEBSITE
  FACEBOOK
  FLEET_COMPANY
  OTHER
}

enum LeadStatus {
  NEW
  PENDING
  CONTACTED
  VISITED
  INTERESTED
  QUOTED
  NEGOTIATING
  WON
  LOST
  CLOSED
  CANCELLED
}

enum JobSource {
  WALK_IN
  INSURANCE_CLAIM
  DEALER
  FLEET
  TRADE
  EXISTING_CUSTOMER
  LEAD_CONVERSION
}

enum JobStatus {
  RECEIVED
  INSPECTION
  QUOTED
  AWAITING_APPROVAL
  APPROVED
  PARTS_ORDERED
  IN_PROGRESS
  PANEL_BEATING
  PAINTING
  QUALITY_CHECK
  READY_FOR_DELIVERY
  COMPLETED
  INVOICED
  CLOSED
}

enum JobPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum BusinessCompany {
  CEYLON_AUTOMOBILE
  WEST_PANEL_AND_TYRES
}

enum JobType {
  PAINTING
  MECHANICAL
  ELECTRICAL
  PANEL_BEATING
  INSTALLATIONS
  TYRES
  BODY_WORK
  OTHER
}

enum JobCategory {
  DEALER
  NON_DEALER
  BUSINESS
}

enum JobSubTaskType {
  PAINTING
  INSTALLATION
  PARTS
  PANEL_BEATING
  MECHANICAL
  ELECTRICAL
  LABOUR
  BODY_WORK
  TYRES
  OTHER
}

enum PartCategory {
  BODY_KIT
  TAIL_LIGHTS
  BUMPER
  HEADLIGHTS
  MIRRORS
  GRILLE
  SPOILER
  FENDER
  BONNET
  DOOR
  OTHER
}

enum PartSaleStatus {
  PENDING
  SOLD
  CANCELLED
}

enum ClaimStatus {
  PENDING
  ASSESSMENT_REQUIRED
  APPROVED
  PARTIALLY_APPROVED
  REJECTED
  COMPLETED
}

enum QuotationStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  CONVERTED_TO_JOB
}

enum InvoicePaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
}

enum NotificationType {
  INFO
  WARNING
  SUCCESS
  ERROR
}

enum AiLogType {
  CUSTOMER_MESSAGE
  WORKSHOP_ASSISTANT
  INSURANCE_ASSISTANT
  SALES_ASSISTANT
  QUOTATION_GENERATOR
}

// ─── Users & Roles ───────────────────────────────────────────────────────────

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  /// Page keys this role can access (e.g. "dashboard", "jobs"). Use ["*"] for all pages.
  permissions Json     @default("[]")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  users User[]

  @@map("roles")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  firstName    String    @map("first_name")
  lastName     String    @map("last_name")
  phone        String?
  roleId       String    @map("role_id") @db.Uuid
  /// When set, overrides role.permissions for page access. null = inherit from role.
  allowedPages Json?     @map("allowed_pages")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")
  createdById  String?   @map("created_by_id") @db.Uuid
  updatedById  String?   @map("updated_by_id") @db.Uuid

  role              Role              @relation(fields: [roleId], references: [id])
  refreshTokens     RefreshToken[]
  assignedLeads     Lead[]            @relation("AssignedLeads")
  assignedJobs      Job[]             @relation("AssignedTechnician")
  jobStatusChanges  JobStatusHistory[]
  aiLogs            AiLog[]
  notifications     Notification[]
  attendanceEvents  AttendanceEvent[]

  @@index([roleId])
  @@index([email])
  @@index([deletedAt])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ─── Customers & Vehicles ────────────────────────────────────────────────────

model Customer {
  id            String       @id @default(uuid()) @db.Uuid
  customerCode  String       @unique @map("customer_code")
  name          String
  companyName   String?         @map("company_name")
  company       BusinessCompany @default(CEYLON_AUTOMOBILE)
  contactPerson String?      @map("contact_person")
  phone         String?
  email         String?
  address       String?
  customerType  CustomerType @map("customer_type")
  source        String?
  notes         String?
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  deletedAt     DateTime?    @map("deleted_at")
  createdById   String?      @map("created_by_id") @db.Uuid
  updatedById   String?      @map("updated_by_id") @db.Uuid

  vehicles        Vehicle[]
  leads           Lead[]
  jobs            Job[]
  insuranceClaims InsuranceClaim[]
  quotations      Quotation[]
  invoices        Invoice[]
  partSales       PartSale[]

  @@index([customerType])
  @@index([company])
  @@index([phone])
  @@index([email])
  @@index([deletedAt])
  @@map("customers")
}

model Vehicle {
  id               String    @id @default(uuid()) @db.Uuid
  vehicleCode      String    @unique @map("vehicle_code")
  registrationNo   String    @map("registration_no")
  make             String
  model            String
  year             Int?
  colour           String?
  vin              String?
  engineNumber     String?   @map("engine_number")
  ownerId          String    @map("owner_id") @db.Uuid
  notes            String?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")
  createdById      String?   @map("created_by_id") @db.Uuid
  updatedById      String?   @map("updated_by_id") @db.Uuid

  owner           Customer         @relation(fields: [ownerId], references: [id])
  jobs            Job[]
  insuranceClaims InsuranceClaim[]
  photos          VehiclePhoto[]

  @@index([ownerId])
  @@index([registrationNo])
  @@index([deletedAt])
  @@map("vehicles")
}

model VehiclePhoto {
  id        String   @id @default(uuid()) @db.Uuid
  vehicleId String   @map("vehicle_id") @db.Uuid
  jobId     String?  @map("job_id") @db.Uuid
  url       String
  caption   String?
  createdAt DateTime @default(now()) @map("created_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
  job     Job?    @relation(fields: [jobId], references: [id])

  @@index([vehicleId])
  @@index([jobId])
  @@map("vehicle_photos")
}

// ─── CRM Leads ───────────────────────────────────────────────────────────────

model Lead {
  id             String     @id @default(uuid()) @db.Uuid
  leadCode       String     @unique @map("lead_code")
  customerName   String          @map("customer_name")
  companyName    String?         @map("company_name")
  company        BusinessCompany @default(CEYLON_AUTOMOBILE)
  phone          String?
  email          String?
  source         LeadSource
  status         LeadStatus @default(NEW)
  assignedUserId String?    @map("assigned_user_id") @db.Uuid
  customerId     String?    @map("customer_id") @db.Uuid
  estimatedPrice Decimal?   @map("estimated_price") @db.Decimal(12, 2)
  notes          String?
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  deletedAt      DateTime?  @map("deleted_at")
  createdById    String?    @map("created_by_id") @db.Uuid
  updatedById    String?    @map("updated_by_id") @db.Uuid

  assignedUser User?     @relation("AssignedLeads", fields: [assignedUserId], references: [id])
  customer     Customer? @relation(fields: [customerId], references: [id])
  followUps    LeadFollowUp[]

  @@index([status])
  @@index([company])
  @@index([assignedUserId])
  @@index([source])
  @@index([deletedAt])
  @@map("leads")
}

model LeadFollowUp {
  id          String     @id @default(uuid()) @db.Uuid
  leadId      String     @map("lead_id") @db.Uuid
  status      LeadStatus @default(CONTACTED)
  description String     @map("notes")
  nextDate    DateTime?  @map("next_date")
  createdAt   DateTime   @default(now()) @map("created_at")
  createdById String?    @map("created_by_id") @db.Uuid

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([status])
  @@index([createdAt])
  @@map("lead_follow_ups")
}

// ─── Workshop Jobs ───────────────────────────────────────────────────────────

enum OutInvoiceType {
  TAX
  CASH
}

model Job {
  id                   String    @id @default(uuid()) @db.Uuid
  jobNumber            String    @unique @map("job_number")
  customerId           String    @map("customer_id") @db.Uuid
  vehicleId            String    @map("vehicle_id") @db.Uuid
  jobSource            JobSource       @map("job_source")
  company              BusinessCompany @default(CEYLON_AUTOMOBILE)
  jobType              JobType         @default(OTHER) @map("job_type")
  jobCategory          JobCategory?    @map("job_category")
  receivedDate         DateTime        @default(now()) @map("received_date")
  dueDate              DateTime? @map("due_date")
  assignedTechnicianId String?     @map("assigned_technician_id") @db.Uuid
  status               JobStatus   @default(RECEIVED)
  priority             JobPriority @default(NORMAL)
  estimatedPrice       Decimal?    @map("estimated_price") @db.Decimal(12, 2)
  addGst               Boolean     @default(false) @map("add_gst")
  description          String?
  internalNotes        String?   @map("internal_notes")
  outDate              DateTime?       @map("out_date")
  outInvoiceType       OutInvoiceType? @map("out_invoice_type")
  outInvoiceNumber     String?         @map("out_invoice_number")
  outNotes             String?         @map("out_notes")
  deleteRemarks        String?         @map("delete_remarks")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  deletedAt            DateTime? @map("deleted_at")
  createdById          String?   @map("created_by_id") @db.Uuid
  updatedById          String?   @map("updated_by_id") @db.Uuid

  customer           Customer           @relation(fields: [customerId], references: [id])
  vehicle            Vehicle            @relation(fields: [vehicleId], references: [id])
  assignedTechnician User?              @relation("AssignedTechnician", fields: [assignedTechnicianId], references: [id])
  statusHistory      JobStatusHistory[]
  insuranceClaim     InsuranceClaim?
  quotations         Quotation[]
  invoices           Invoice[]
  photos             VehiclePhoto[]
  subTasks           JobSubTask[]
  collections        JobCollection[]
  expenses           Expense[]

  @@index([customerId])
  @@index([vehicleId])
  @@index([status])
  @@index([company])
  @@index([jobType])
  @@index([jobCategory])
  @@index([priority])
  @@index([assignedTechnicianId])
  @@index([receivedDate])
  @@index([outDate])
  @@index([outInvoiceType])
  @@index([deletedAt])
  @@map("jobs")
}

model JobStatusHistory {
  id        String    @id @default(uuid()) @db.Uuid
  jobId     String    @map("job_id") @db.Uuid
  fromStatus JobStatus? @map("from_status")
  toStatus  JobStatus @map("to_status")
  notes     String?
  changedById String? @map("changed_by_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")

  job       Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  changedBy User? @relation(fields: [changedById], references: [id])

  @@index([jobId])
  @@index([createdAt])
  @@map("job_status_history")
}

model JobSubTask {
  id          String         @id @default(uuid()) @db.Uuid
  jobId       String         @map("job_id") @db.Uuid
  taskType    JobSubTaskType @map("task_type")
  description String
  price       Decimal?       @db.Decimal(12, 2)
  sortOrder   Int            @default(0) @map("sort_order")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("job_sub_tasks")
}

// ─── Insurance Claims ────────────────────────────────────────────────────────

model InsuranceClaim {
  id                String      @id @default(uuid()) @db.Uuid
  claimCode         String      @unique @map("claim_code")
  insuranceCompany  String      @map("insurance_company")
  claimNumber       String?     @map("claim_number")
  policyNumber      String?     @map("policy_number")
  customerId        String      @map("customer_id") @db.Uuid
  vehicleId         String      @map("vehicle_id") @db.Uuid
  jobId             String?     @unique @map("job_id") @db.Uuid
  assessorName      String?     @map("assessor_name")
  approvalStatus    ClaimStatus @default(PENDING) @map("approval_status")
  approvedAmount    Decimal?    @map("approved_amount") @db.Decimal(12, 2)
  excessAmount      Decimal?    @map("excess_amount") @db.Decimal(12, 2)
  notes             String?
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")
  deletedAt         DateTime?   @map("deleted_at")
  createdById       String?     @map("created_by_id") @db.Uuid
  updatedById       String?     @map("updated_by_id") @db.Uuid

  customer Customer @relation(fields: [customerId], references: [id])
  vehicle  Vehicle  @relation(fields: [vehicleId], references: [id])
  job      Job?     @relation(fields: [jobId], references: [id])

  @@index([customerId])
  @@index([vehicleId])
  @@index([approvalStatus])
  @@index([deletedAt])
  @@map("insurance_claims")
}

// ─── Quotations ──────────────────────────────────────────────────────────────

model Quotation {
  id             String          @id @default(uuid()) @db.Uuid
  quotationNumber String         @unique @map("quotation_number")
  customerId     String          @map("customer_id") @db.Uuid
  jobId          String?         @map("job_id") @db.Uuid
  labourCost     Decimal         @default(0) @map("labour_cost") @db.Decimal(12, 2)
  partsCost      Decimal         @default(0) @map("parts_cost") @db.Decimal(12, 2)
  paintCost      Decimal         @default(0) @map("paint_cost") @db.Decimal(12, 2)
  discount       Decimal         @default(0) @db.Decimal(12, 2)
  gst            Decimal         @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal         @default(0) @map("total_amount") @db.Decimal(12, 2)
  status         QuotationStatus @default(DRAFT)
  validUntil     DateTime?       @map("valid_until")
  notes          String?
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  deletedAt      DateTime?       @map("deleted_at")
  createdById    String?         @map("created_by_id") @db.Uuid
  updatedById    String?         @map("updated_by_id") @db.Uuid

  customer Customer        @relation(fields: [customerId], references: [id])
  job      Job?            @relation(fields: [jobId], references: [id])
  items    QuotationItem[]

  @@index([customerId])
  @@index([jobId])
  @@index([status])
  @@index([deletedAt])
  @@map("quotations")
}

model QuotationItem {
  id          String  @id @default(uuid()) @db.Uuid
  quotationId String  @map("quotation_id") @db.Uuid
  description String
  quantity    Decimal @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  totalPrice  Decimal @map("total_price") @db.Decimal(12, 2)
  itemType    String  @default("PART") @map("item_type")
  sortOrder   Int     @default(0) @map("sort_order")

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@map("quotation_items")
}

// ─── Invoices & Payments ─────────────────────────────────────────────────────

model Invoice {
  id            String               @id @default(uuid()) @db.Uuid
  invoiceNumber String               @unique @map("invoice_number")
  jobId         String?              @map("job_id") @db.Uuid
  customerId    String               @map("customer_id") @db.Uuid
  subtotal      Decimal              @default(0) @db.Decimal(12, 2)
  gst           Decimal              @default(0) @db.Decimal(12, 2)
  includeGst    Boolean              @default(true) @map("include_gst")
  discount      Decimal              @default(0) @db.Decimal(12, 2)
  total         Decimal              @default(0) @db.Decimal(12, 2)
  amountPaid    Decimal              @default(0) @map("amount_paid") @db.Decimal(12, 2)
  paymentStatus InvoicePaymentStatus @default(UNPAID) @map("payment_status")
  dueDate       DateTime?            @map("due_date")
  notes         String?
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")
  deletedAt     DateTime?            @map("deleted_at")
  createdById   String?              @map("created_by_id") @db.Uuid
  updatedById   String?              @map("updated_by_id") @db.Uuid

  job         Job?            @relation(fields: [jobId], references: [id])
  customer    Customer        @relation(fields: [customerId], references: [id])
  payments    Payment[]
  lineItems   InvoiceLineItem[]
  collections JobCollection[]

  @@index([customerId])
  @@index([jobId])
  @@index([paymentStatus])
  @@index([deletedAt])
  @@map("invoices")
}

model InvoiceLineItem {
  id          String          @id @default(uuid()) @db.Uuid
  invoiceId   String          @map("invoice_id") @db.Uuid
  description String
  taskType    JobSubTaskType? @map("task_type")
  unitPrice   Decimal         @map("unit_price") @db.Decimal(12, 2)
  quantity    Decimal         @default(1) @db.Decimal(10, 2)
  lineTotal   Decimal         @map("line_total") @db.Decimal(12, 2)
  sortOrder   Int             @default(0) @map("sort_order")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_line_items")
}

model Payment {
  id            String   @id @default(uuid()) @db.Uuid
  invoiceId     String   @map("invoice_id") @db.Uuid
  amount        Decimal  @db.Decimal(12, 2)
  paymentMethod String   @map("payment_method")
  reference     String?
  notes         String?
  paidAt        DateTime @default(now()) @map("paid_at")
  createdAt     DateTime @default(now()) @map("created_at")
  createdById   String?  @map("created_by_id") @db.Uuid

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([paidAt])
  @@map("payments")
}

// ─── Finance: Expenses & Job Collections ─────────────────────────────────────

enum ExpenseCategory {
  LABOUR
  MATERIAL
  OTHER
}

enum ExpenseMaterialType {
  PAINT
  PARTS
  CONSUMABLES
  OTHER
}

enum ExpenseOtherType {
  UTILITY
  RENT
  SALARY
  GOOGLE
  FUEL
  INTERNET
  INSURANCE
  MARKETING
  SOFTWARE
  BANK_FEES
  OFFICE
  OTHER
}

enum CollectionType {
  ADVANCE
  SECOND
  FINAL
  OTHER
}

// ─── Suppliers ───────────────────────────────────────────────────────────────

model Supplier {
  id           String    @id @default(uuid()) @db.Uuid
  supplierCode String    @unique @map("supplier_code")
  name         String
  contactPerson String?  @map("contact_person")
  phone        String?
  email        String?
  address      String?
  notes        String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")
  createdById  String?   @map("created_by_id") @db.Uuid
  updatedById  String?   @map("updated_by_id") @db.Uuid

  expenses Expense[]

  @@index([name])
  @@index([phone])
  @@index([deletedAt])
  @@map("suppliers")
}

// ─── Employees / Labours (wage payees; not CRM login users) ───────────────────

model Employee {
  id           String    @id @default(uuid()) @db.Uuid
  employeeCode String    @unique @map("employee_code")
  name         String
  jobTitle     String?   @map("job_title")
  phone        String?
  email        String?
  notes        String?
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")
  createdById  String?   @map("created_by_id") @db.Uuid
  updatedById  String?   @map("updated_by_id") @db.Uuid

  expenses Expense[]

  @@index([name])
  @@index([phone])
  @@index([isActive])
  @@index([deletedAt])
  @@map("employees")
}

// ─── Finance Expenses / Collections ──────────────────────────────────────────

model Expense {
  id            String               @id @default(uuid()) @db.Uuid
  jobId         String?              @map("job_id") @db.Uuid
  supplierId    String?              @map("supplier_id") @db.Uuid
  employeeId    String?              @map("employee_id") @db.Uuid
  category      ExpenseCategory
  materialType  ExpenseMaterialType? @map("material_type")
  otherType     ExpenseOtherType?    @map("other_type")
  description   String
  amount        Decimal              @db.Decimal(12, 2)
  expenseDate   DateTime             @map("expense_date") @db.Date
  isPayable     Boolean              @default(false) @map("is_payable")
  paymentMethod String?              @map("payment_method")
  reference     String?
  notes         String?
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")
  deletedAt     DateTime?            @map("deleted_at")
  createdById   String?              @map("created_by_id") @db.Uuid

  job      Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)
  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([jobId])
  @@index([supplierId])
  @@index([employeeId])
  @@index([category])
  @@index([otherType])
  @@index([expenseDate])
  @@index([isPayable])
  @@index([deletedAt])
  @@map("expenses")
}

/// Money collected against a job (advance / part / final). Can exist before an invoice.
model JobCollection {
  id             String         @id @default(uuid()) @db.Uuid
  jobId          String?        @map("job_id") @db.Uuid
  invoiceId      String?        @map("invoice_id") @db.Uuid
  amount         Decimal        @db.Decimal(12, 2)
  paymentMethod  String         @map("payment_method")
  collectionType CollectionType @default(OTHER) @map("collection_type")
  paidAt         DateTime       @default(now()) @map("paid_at")
  reference      String?
  notes          String?
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  deletedAt      DateTime?      @map("deleted_at")
  createdById    String?        @map("created_by_id") @db.Uuid

  job     Job?     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([jobId])
  @@index([invoiceId])
  @@index([paidAt])
  @@index([paymentMethod])
  @@index([deletedAt])
  @@map("job_collections")
}

// ─── Inventory ─────────────────────────────────────────────────────────────────

model InventoryItem {
  id           String          @id @default(uuid()) @db.Uuid
  itemCode     String          @unique @map("item_code")
  itemName     String          @map("item_name")
  company      BusinessCompany @default(CEYLON_AUTOMOBILE)
  partCategory PartCategory    @map("part_category")
  vehicleMake  String?         @map("vehicle_make")
  vehicleModel String?         @map("vehicle_model")
  description  String?
  costPrice    Decimal         @map("cost_price") @db.Decimal(12, 2)
  sellingPrice Decimal         @map("selling_price") @db.Decimal(12, 2)
  quantity     Int             @default(0)
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  deletedAt    DateTime?       @map("deleted_at")
  createdById  String?         @map("created_by_id") @db.Uuid
  updatedById  String?         @map("updated_by_id") @db.Uuid

  partSales PartSale[]

  @@index([company])
  @@index([partCategory])
  @@index([vehicleMake])
  @@index([deletedAt])
  @@map("inventory_items")
}

// ─── Parts Sales ─────────────────────────────────────────────────────────────

model PartSale {
  id              String          @id @default(uuid()) @db.Uuid
  saleCode        String          @unique @map("sale_code")
  inventoryItemId String?         @map("inventory_item_id") @db.Uuid
  company         BusinessCompany @default(CEYLON_AUTOMOBILE)
  partCategory    PartCategory    @map("part_category")
  partName        String          @map("part_name")
  customerId      String?         @map("customer_id") @db.Uuid
  customerName    String          @map("customer_name")
  phone           String?
  quantity        Int             @default(1)
  unitPrice       Decimal         @map("unit_price") @db.Decimal(12, 2)
  totalPrice      Decimal         @map("total_price") @db.Decimal(12, 2)
  status          PartSaleStatus  @default(PENDING)
  notes           String?
  soldAt          DateTime?       @map("sold_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  deletedAt       DateTime?       @map("deleted_at")
  createdById     String?         @map("created_by_id") @db.Uuid
  updatedById     String?         @map("updated_by_id") @db.Uuid

  customer      Customer?      @relation(fields: [customerId], references: [id])
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id])

  @@index([inventoryItemId])
  @@index([company])
  @@index([partCategory])
  @@index([status])
  @@index([deletedAt])
  @@map("part_sales")
}

// ─── Notifications & AI Logs ─────────────────────────────────────────────────

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  title     String
  message   String
  type      NotificationType @default(INFO)
  isRead    Boolean          @default(false) @map("is_read")
  link      String?
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

model AiLog {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String?   @map("user_id") @db.Uuid
  type         AiLogType
  prompt       String
  response     String
  tokensUsed   Int?      @map("tokens_used")
  model        String    @default("deepseek-chat")
  entityType   String?   @map("entity_type")
  entityId     String?   @map("entity_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@map("ai_logs")
}

// ─── Attendance ──────────────────────────────────────────────────────────────

model AttendanceEvent {
  id             String              @id @default(uuid()) @db.Uuid
  userId         String              @map("user_id") @db.Uuid
  eventType      AttendanceEventType @map("event_type")
  eventAt        DateTime            @default(now()) @map("event_at")
  latitude       Decimal             @db.Decimal(10, 7)
  longitude      Decimal             @db.Decimal(10, 7)
  distanceMeters Float               @map("distance_meters")
  withinGeofence Boolean             @map("within_geofence")
  workDate       DateTime            @map("work_date") @db.Date
  clockOutReason ClockOutReason?     @map("clock_out_reason")
  createdAt      DateTime            @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, workDate])
  @@index([workDate])
  @@index([eventAt])
  @@map("attendance_events")
}
